# The status site's queue. The edge leases work from it and hands transcripts back;
# the site does everything user-facing, so these are the only credentials an edge needs.
QUEUE_API_URL=https://status.eliezer.ivrit.ai
QUEUE_TOKEN=your-shared-queue-token
# Names this edge in the site's statistics and logs (default: the hostname).
# INSTANCE_ID=primary

# Only when transcribing on RunPod (i.e. not running with --local).
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-runpod-endpoint-id
